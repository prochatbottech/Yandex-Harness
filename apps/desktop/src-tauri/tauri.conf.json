{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness Desktop",
  "version": "0.1.1",
  "identifier": "com.harness.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Harness Desktop — Агент на моделях Яндекса",
        "width": 1150,
        "height": 780,
        "minWidth": 850,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../../../apps/core/dist/sidecar.js"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
